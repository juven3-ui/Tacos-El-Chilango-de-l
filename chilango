<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nova Estudio — Diseño y branding que se recuerda</title>
<meta name="description" content="Estudio creativo especializado en branding, diseño web y contenido. Creamos marcas con carácter.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Inter:wght@300..700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f6f3ec;
    --bg-2:#efeade;
    --ink:#16151a;
    --ink-soft:#3a3742;
    --muted:#6f6a76;
    --accent:#ff5a3c;
    --accent-dark:#e04327;
    --violet:#5b3df5;
    --lime:#d9f36a;
    --line:rgba(22,21,26,.12);
    --card:#fffdf8;
    --display:'Bricolage Grotesque',system-ui,sans-serif;
    --sans:'Inter',system-ui,-apple-system,sans-serif;
    --radius:22px;
    --shadow:0 26px 50px -30px rgba(22,21,26,.45);
  }

  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  body{
    font-family:var(--sans);
    background:var(--bg);
    color:var(--ink);
    line-height:1.65;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block}
  a{color:inherit;text-decoration:none}
  button{font:inherit;cursor:pointer;border:none;background:none}
  section{scroll-margin-top:92px}

  .wrap{width:min(1200px,100% - 48px);margin-inline:auto}

  /* ---------- tipografía ---------- */
  h1,h2,h3{font-family:var(--display);letter-spacing:-.03em;line-height:1.02;font-weight:700}
  h2{font-size:clamp(2rem,4.6vw,3.4rem)}
  .eyebrow{
    display:inline-flex;align-items:center;gap:.6em;
    font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;
    font-weight:600;color:var(--muted);
  }
  .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--accent);display:inline-block}
  .eyebrow.center::after{content:"";width:26px;height:1.5px;background:var(--accent);display:inline-block}

  /* ---------- botones ---------- */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:.55em;
    padding:15px 28px;border-radius:999px;
    font-weight:600;font-size:.88rem;letter-spacing:.01em;
    border:1.5px solid transparent;
    transition:transform .35s cubic-bezier(.2,.7,.3,1),background .3s,color .3s,border-color .3s,box-shadow .3s;
    white-space:nowrap;
  }
  .btn:hover{transform:translateY(-3px)}
  .btn-primary{background:var(--ink);color:var(--bg);box-shadow:0 14px 26px -18px rgba(22,21,26,.9)}
  .btn-primary:hover{background:var(--accent);box-shadow:0 18px 30px -16px rgba(255,90,60,.75)}
  .btn-ghost{border-color:var(--line);color:var(--ink)}
  .btn-ghost:hover{border-color:var(--ink);background:var(--ink);color:var(--bg)}
  .btn-light{background:var(--bg);color:var(--ink)}
  .btn-light:hover{background:#fff}
  .btn-outline-light{border-color:rgba(246,243,236,.4);color:var(--bg)}
  .btn-outline-light:hover{background:var(--bg);color:var(--ink);border-color:var(--bg)}

  /* ================= NAV ================= */
  .nav{
    position:fixed;inset:0 0 auto 0;z-index:200;
    display:flex;align-items:center;justify-content:space-between;gap:20px;
    padding:20px clamp(18px,4vw,52px);
    transition:padding .35s,background .35s,border-color .35s,backdrop-filter .35s;
    border-bottom:1px solid transparent;
  }
  .nav.scrolled{
    padding-top:11px;padding-bottom:11px;
    background:rgba(246,243,236,.82);
    -webkit-backdrop-filter:blur(16px) saturate(1.5);
    backdrop-filter:blur(16px) saturate(1.5);
    border-bottom-color:var(--line);
  }
  .brand{display:flex;align-items:center;gap:11px;font-family:var(--display);font-weight:800;font-size:1.15rem;letter-spacing:-.03em}
  .brand-mark{
    width:38px;height:38px;flex:0 0 38px;border-radius:12px;
    background:var(--ink);color:var(--bg);
    display:grid;place-items:center;
    font-family:var(--display);font-weight:800;font-size:1.05rem;
    transform:rotate(-6deg);
    transition:transform .4s,background .4s;
  }
  .brand:hover .brand-mark{transform:rotate(6deg);background:var(--accent)}
  .brand small{display:block;font-family:var(--sans);font-weight:500;font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-top:1px}

  .nav-links{display:flex;align-items:center;gap:32px}
  .nav-links a{
    font-size:.84rem;font-weight:500;color:var(--ink-soft);
    position:relative;padding-bottom:3px;
    transition:color .25s;
  }
  .nav-links a::after{
    content:"";position:absolute;left:0;bottom:0;height:2px;width:0;border-radius:2px;
    background:var(--accent);transition:width .35s cubic-bezier(.2,.7,.3,1);
  }
  .nav-links a:hover{color:var(--ink)}
  .nav-links a:hover::after{width:100%}
  .nav-cta{display:flex;align-items:center;gap:14px}
  .nav .btn{padding:11px 22px;font-size:.8rem}

  .menu-toggle{
    display:none;width:44px;height:44px;border-radius:12px;
    border:1.5px solid var(--line);
    align-items:center;justify-content:center;
    background:var(--card);
  }
  .menu-toggle span{
    display:block;width:19px;height:2px;border-radius:2px;background:var(--ink);
    position:relative;transition:transform .3s,background .3s;
  }
  .menu-toggle span::before,.menu-toggle span::after{
    content:"";position:absolute;left:0;width:19px;height:2px;border-radius:2px;background:var(--ink);
    transition:transform .3s,top .3s;
  }
  .menu-toggle span::before{top:-6px}
  .menu-toggle span::after{top:6px}
  .menu-toggle[aria-expanded="true"] span{background:transparent}
  .menu-toggle[aria-expanded="true"] span::before{top:0;transform:rotate(45deg)}
  .menu-toggle[aria-expanded="true"] span::after{top:0;transform:rotate(-45deg)}

  .mobile-panel{
    position:fixed;inset:0 0 auto 0;z-index:190;
    background:var(--bg);
    padding:96px 24px 30px;
    border-bottom:1px solid var(--line);
    transform:translateY(-110%);
    transition:transform .45s cubic-bezier(.2,.7,.3,1);
    box-shadow:0 30px 60px -40px rgba(22,21,26,.6);
  }
  .mobile-panel.open{transform:translateY(0)}
  .mobile-panel a{
    display:block;padding:16px 4px;
    font-family:var(--display);font-size:1.35rem;font-weight:600;letter-spacing:-.02em;
    border-bottom:1px solid var(--line);
  }
  .mobile-panel .btn{margin-top:24px;width:100%}

  /* ================= HERO ================= */
  .hero{
    position:relative;
    padding:clamp(120px,14vw,170px) 0 clamp(60px,8vw,90px);
    overflow:hidden;
    background:
      radial-gradient(70% 60% at 85% 5%,rgba(91,61,245,.12),transparent 65%),
      radial-gradient(60% 55% at 5% 85%,rgba(255,90,60,.14),transparent 65%),
      var(--bg);
  }
  .hero::before{
    content:"";position:absolute;inset:0;pointer-events:none;
    background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);
    background-size:110px 110px;
    opacity:.35;
    -webkit-mask-image:radial-gradient(circle at 50% 45%,#000 0%,transparent 75%);
    mask-image:radial-gradient(circle at 50% 45%,#000 0%,transparent 75%);
  }
  .hero-grid{
    position:relative;z-index:1;
    display:grid;grid-template-columns:1.15fr .85fr;
    gap:clamp(36px,5vw,72px);align-items:center;
  }
  .hero h1{
    font-size:clamp(2.6rem,6.2vw,4.6rem);
    line-height:.98;
    margin:22px 0 24px;
    letter-spacing:-.04em;
  }
  .hero h1 em{
    font-style:italic;font-weight:400;
    color:var(--accent);
    position:relative;
  }
  .hero h1 .u{
    position:relative;white-space:nowrap;
  }
  .hero h1 .u::after{
    content:"";position:absolute;left:0;right:0;bottom:.06em;height:.14em;
    background:var(--lime);border-radius:4px;z-index:-1;
    transform:scaleX(0);transform-origin:left;
    animation:mark 1s .6s cubic-bezier(.2,.7,.3,1) forwards;
  }
  @keyframes mark{to{transform:scaleX(1)}}
  .hero p.lede{
    font-size:clamp(1rem,1.35vw,1.12rem);
    color:var(--muted);max-width:46ch;line-height:1.75;
    margin-bottom:34px;
  }
  .hero-actions{display:flex;gap:13px;flex-wrap:wrap;margin-bottom:40px}
  .hero-trust{
    display:flex;align-items:center;gap:16px;flex-wrap:wrap;
    padding-top:28px;border-top:1px solid var(--line);
  }
  .avatars{display:flex}
  .avatars span{
    width:34px;height:34px;border-radius:50%;
    display:grid;place-items:center;
    font-size:.66rem;font-weight:700;color:#fff;
    border:2px solid var(--bg);margin-left:-10px;
    font-family:var(--sans);
  }
  .avatars span:first-child{margin-left:0}
  .avatars span:nth-child(1){background:#5b3df5}
  .avatars span:nth-child(2){background:#ff5a3c}
  .avatars span:nth-child(3){background:#1f7a5a}
  .avatars span:nth-child(4){background:#c98a1c}
  .hero-trust small{font-size:.78rem;color:var(--muted);line-height:1.4}
  .hero-trust small b{color:var(--ink)}

  /* visual del hero */
  .hero-visual{position:relative}
  .visual-main{
    position:relative;
    aspect-ratio:5/5.6;
    border-radius:28px;
    background:
      radial-gradient(90% 70% at 25% 15%,rgba(255,255,255,.55),transparent 60%),
      linear-gradient(150deg,#6d4bff 0%,#5b3df5 45%,#2f1f96 100%);
    box-shadow:var(--shadow);
    overflow:hidden;
    display:grid;place-items:center;
  }
  .visual-main::before{
    content:"";position:absolute;inset:0;
    background-image:radial-gradient(rgba(255,255,255,.22) 1px,transparent 1px);
    background-size:22px 22px;opacity:.55;
  }
  .visual-main .glyph{
    position:relative;z-index:1;
    font-family:var(--display);font-weight:800;
    font-size:clamp(4.5rem,11vw,7.5rem);
    color:var(--bg);letter-spacing:-.06em;
    line-height:1;
    transform:rotate(-8deg);
    text-shadow:0 20px 40px rgba(0,0,0,.28);
  }
  .visual-main .tag{
    position:absolute;left:22px;top:22px;z-index:2;
    font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;font-weight:700;
    color:rgba(255,255,255,.85);
    background:rgba(255,255,255,.14);
    border:1px solid rgba(255,255,255,.28);
    padding:7px 13px;border-radius:999px;
    -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);
  }
  .float-card{
    position:absolute;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:16px;
    padding:13px 17px;
    box-shadow:0 24px 40px -26px rgba(22,21,26,.55);
    display:flex;align-items:center;gap:11px;
  }
  .float-card .ic{
    width:34px;height:34px;flex:0 0 34px;border-radius:10px;
    display:grid;place-items:center;font-size:.95rem;
  }
  .float-card b{display:block;font-family:var(--display);font-size:1.02rem;line-height:1.1;letter-spacing:-.02em}
  .float-card small{font-size:.63rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600}
  .fc-1{left:-22px;top:16%;animation:float1 7s ease-in-out infinite}
  .fc-1 .ic{background:rgba(255,90,60,.16)}
  .fc-2{right:-16px;bottom:20%;animation:float2 8s ease-in-out infinite}
  .fc-2 .ic{background:rgba(91,61,245,.14)}
  @keyframes float1{0%,100%{transform:translateY(-7px)}50%{transform:translateY(7px)}}
  @keyframes float2{0%,100%{transform:translateY(8px)}50%{transform:translateY(-8px)}}

  /* ================= MARQUEE ================= */
  .marquee{
    background:var(--ink);color:var(--bg);
    padding:17px 0;overflow:hidden;position:relative;
  }
  .marquee::before,.marquee::after{
    content:"";position:absolute;top:0;bottom:0;width:100px;z-index:2;pointer-events:none;
  }
  .marquee::before{left:0;background:linear-gradient(90deg,var(--ink),transparent)}
  .marquee::after{right:0;background:linear-gradient(270deg,var(--ink),transparent)}
  .track{display:flex;width:max-content;animation:slide 42s linear infinite;will-change:transform}
  .marquee:hover .track{animation-play-state:paused}
  @keyframes slide{to{transform:translateX(-50%)}}
  .track span{
    display:inline-flex;align-items:center;
    font-family:var(--display);font-weight:600;
    font-size:.95rem;letter-spacing:.1em;text-transform:uppercase;
    margin-right:30px;white-space:nowrap;
  }
  .track span i{color:var(--accent);font-style:normal;margin-left:30px;font-size:.8em}

  /* ================= SERVICIOS ================= */
  .section{padding:clamp(70px,9vw,120px) 0}
  .sec-head{max-width:640px;margin-bottom:clamp(38px,5vw,58px)}
  .sec-head.center{margin-inline:auto;text-align:center}
  .sec-head h2{margin:18px 0 14px}
  .sec-head p{color:var(--muted);font-size:1rem;line-height:1.75}

  .services{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  .service{
    position:relative;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:clamp(26px,3vw,36px);
    transition:transform .45s cubic-bezier(.2,.7,.3,1),box-shadow .45s,border-color .45s;
    overflow:hidden;
  }
  .service::after{
    content:"";position:absolute;inset:auto -40% -70% auto;width:220px;height:220px;border-radius:50%;
    background:radial-gradient(circle,rgba(255,90,60,.18),transparent 70%);
    opacity:0;transition:opacity .45s;
  }
  .service:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:rgba(22,21,26,.2)}
  .service:hover::after{opacity:1}
  .service-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:22px}
  .service-ic{
    width:52px;height:52px;flex:0 0 52px;border-radius:15px;
    display:grid;place-items:center;
    background:var(--bg-2);color:var(--ink);
    transition:background .4s,color .4s,transform .4s;
  }
  .service:hover .service-ic{background:var(--ink);color:var(--bg);transform:rotate(-6deg)}
  .service-ic svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .service-num{
    font-family:var(--display);font-size:.8rem;font-weight:700;
    color:var(--muted);letter-spacing:.06em;
  }
  .service h3{font-size:1.28rem;margin-bottom:10px;letter-spacing:-.02em}
  .service p{font-size:.92rem;color:var(--muted);line-height:1.7}
  .service ul{list-style:none;margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
  .service ul li{
    font-size:.7rem;font-weight:600;letter-spacing:.04em;
    padding:5px 11px;border-radius:999px;
    background:var(--bg-2);color:var(--ink-soft);
  }

  /* ================= PROCESO ================= */
  .process{background:var(--bg-2);border-block:1px solid var(--line)}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .step{
    position:relative;padding-top:26px;
    border-top:2px solid var(--ink);
  }
  .step .n{
    font-family:var(--display);font-size:.78rem;font-weight:800;
    letter-spacing:.16em;color:var(--accent);
    display:block;margin-bottom:14px;
  }
  .step h3{font-size:1.22rem;margin-bottom:10px;letter-spacing:-.02em}
  .step p{font-size:.9rem;color:var(--muted);line-height:1.7}

  /* ================= NOSOTROS ================= */
  .about-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(36px,6vw,80px);align-items:center}
  .about-visual{
    position:relative;aspect-ratio:4/4.3;border-radius:26px;
    background:linear-gradient(155deg,#ffb59e 0%,#ff5a3c 48%,#c02f16 100%);
    overflow:hidden;box-shadow:var(--shadow);
    display:grid;place-items:center;
  }
  .about-visual::before{
    content:"";position:absolute;inset:-40%;
    background:repeating-linear-gradient(45deg,rgba(255,255,255,.14) 0 2px,transparent 2px 20px);
  }
  .about-visual .stat-big{
    position:relative;z-index:1;text-align:center;color:#fff;
  }
  .about-visual .stat-big b{
    display:block;font-family:var(--display);font-weight:800;
    font-size:clamp(3.4rem,8vw,5.4rem);line-height:.9;letter-spacing:-.05em;
    text-shadow:0 18px 36px rgba(120,30,0,.35);
  }
  .about-visual .stat-big span{
    display:block;margin-top:10px;
    font-size:.66rem;letter-spacing:.24em;text-transform:uppercase;font-weight:700;opacity:.92;
  }
  .about-badge{
    position:absolute;right:-14px;top:26px;
    background:var(--card);border:1px solid var(--line);
    border-radius:14px;padding:11px 15px;
    box-shadow:0 20px 34px -24px rgba(22,21,26,.6);
    transform:rotate(5deg);
  }
  .about-badge b{display:block;font-family:var(--display);font-size:1rem;line-height:1.1}
  .about-badge small{font-size:.56rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:700}

  .about-text h2{margin:18px 0 20px}
  .about-text p{color:var(--muted);font-size:.98rem;line-height:1.8;margin-bottom:16px}
  .about-text .lead{color:var(--ink-soft);font-size:1.05rem;line-height:1.75}
  .about-stats{
    display:grid;grid-template-columns:repeat(3,1fr);gap:18px;
    margin-top:32px;padding-top:28px;border-top:1px solid var(--line);
  }
  .about-stats b{
    display:block;font-family:var(--display);font-size:clamp(1.4rem,2.4vw,1.9rem);
    font-weight:800;letter-spacing:-.03em;line-height:1;
  }
  .about-stats span{
    display:block;margin-top:7px;font-size:.62rem;letter-spacing:.14em;
    text-transform:uppercase;color:var(--muted);font-weight:700;
  }

  /* ================= TESTIMONIOS ================= */
  .testi{background:var(--ink);color:var(--bg);position:relative;overflow:hidden}
  .testi::before{
    content:"";position:absolute;top:-30%;left:-10%;width:60vw;height:60vw;max-width:700px;max-height:700px;
    border-radius:50%;background:radial-gradient(circle,rgba(91,61,245,.35),transparent 68%);
    pointer-events:none;
  }
  .testi .sec-head{position:relative;z-index:1}
  .testi .sec-head h2{color:var(--bg)}
  .testi .sec-head p{color:rgba(246,243,236,.6)}
  .testi .eyebrow{color:rgba(246,243,236,.55)}
  .quotes{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .quote{
    background:rgba(246,243,236,.05);
    border:1px solid rgba(246,243,236,.12);
    border-radius:var(--radius);
    padding:28px 26px;
    display:flex;flex-direction:column;
    transition:background .35s,border-color .35s,transform .35s;
  }
  .quote:hover{background:rgba(246,243,236,.09);border-color:rgba(246,243,236,.26);transform:translateY(-5px)}
  .quote .stars{color:var(--lime);font-size:.8rem;letter-spacing:.16em;margin-bottom:16px}
  .quote p{font-size:.94rem;line-height:1.75;color:rgba(246,243,236,.86);flex:1}
  .quote footer{display:flex;align-items:center;gap:11px;margin-top:22px;padding-top:18px;border-top:1px solid rgba(246,243,236,.12)}
  .quote .who{
    width:36px;height:36px;flex:0 0 36px;border-radius:50%;
    display:grid;place-items:center;
    font-size:.7rem;font-weight:700;color:var(--ink);background:var(--lime);
    font-family:var(--sans);
  }
  .quote .who.a2{background:#ffb59e}
  .quote .who.a3{background:#b8a9ff}
  .quote footer b{display:block;font-size:.84rem;font-weight:600;color:var(--bg)}
  .quote footer small{font-size:.72rem;color:rgba(246,243,236,.55)}

  /* ================= CTA ================= */
  .cta-band{
    position:relative;text-align:center;
    padding:clamp(70px,9vw,110px) 24px;
    background:linear-gradient(150deg,#ff5a3c 0%,#e04327 60%,#a82c14 100%);
    color:#fff;overflow:hidden;
  }
  .cta-band::before{
    content:"";position:absolute;inset:0;
    background-image:repeating-linear-gradient(45deg,rgba(255,255,255,.06) 0 2px,transparent 2px 24px);
    pointer-events:none;
  }
  .cta-band > *{position:relative;z-index:1}
  .cta-band h2{font-size:clamp(2.2rem,5.6vw,3.8rem);margin-bottom:18px;color:#fff}
  .cta-band p{max-width:48ch;margin:0 auto 34px;color:rgba(255,255,255,.86);font-size:1rem}
  .cta-actions{display:flex;gap:13px;justify-content:center;flex-wrap:wrap}

  /* ================= CONTACTO ================= */
